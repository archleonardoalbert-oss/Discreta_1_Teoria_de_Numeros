#!/usr/bin/env python3
"""Sirve la biblioteca en local y lo abre en el navegador.

Uso: ./abrir-biblioteca            (abre el navegador)
     ./abrir-biblioteca --sin-abrir (solo sirve; útil para pruebas)
"""
import functools
import http.server
import os
import socket
import sys
import threading
import webbrowser

RAIZ = os.path.dirname(os.path.abspath(__file__))


def puerto_libre(desde=8780):
    for p in range(desde, desde + 50):
        with socket.socket() as s:
            if s.connect_ex(("127.0.0.1", p)) != 0:
                return p
    raise SystemExit("No hay puertos libres entre 8780 y 8829")


class Manejador(http.server.SimpleHTTPRequestHandler):
    extensions_map = {**http.server.SimpleHTTPRequestHandler.extensions_map,
                      ".js": "text/javascript", ".mjs": "text/javascript",
                      ".woff2": "font/woff2", ".ttf": "font/ttf"}

    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def log_message(self, *a):
        pass


def main():
    puerto = puerto_libre()
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", puerto),
                                          functools.partial(Manejador, directory=RAIZ))
    url = f"http://localhost:{puerto}/"
    print(f"Biblioteca en {url}  (Ctrl+C para salir)", flush=True)
    if "--sin-abrir" not in sys.argv:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()   # Linux, macOS y Windows
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
